{
  "name": "bb-autoresearch",
  "version": "0.2.4",
  "type": "module",
  "description": "Long-running, measured code-optimization studies: short-lived agent workers propose changes, the plugin measures every candidate and decides what to keep.",
  "license": "MIT",
  "author": "Pascal de Ladurantaye <pascal.de.ladurantaye@gmail.com>",
  "homepage": "https://github.com/pascal-de-ladurantaye/bb-autoresearch",
  "keywords": [
    "bb-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pascal-de-ladurantaye/bb-autoresearch.git"
  },
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.14"
  },
  "bb": {
    "name": "Autoresearch",
    "description": "Measured code-optimization studies: agent workers propose changes, the plugin benchmarks every candidate and keeps only statistically real wins.",
    "branding": {
      "icon": "./assets/flask.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "skills": [
      "skills"
    ],
    "app": "./app.tsx"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.4.0",
    "smol-toml": "^1.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.14",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.19",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
